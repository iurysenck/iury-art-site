{
    "mcpServers": {
        "github.com/contextstream/mcp-server": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "--prefer-online",
                "-y",
                "@contextstream/mcp-server@latest"
            ],
            "env": {
                "CONTEXTSTREAM_API_URL": "https://api.contextstream.io",
                "CONTEXTSTREAM_API_KEY": "",
                "CONTEXTSTREAM_TOOLSET": "complete",
                "CONTEXTSTREAM_TRANSCRIPTS_ENABLED": "true",
                "CONTEXTSTREAM_HOOK_TRANSCRIPTS_ENABLED": "true",
                "CONTEXTSTREAM_SEARCH_LIMIT": "15",
                "CONTEXTSTREAM_SEARCH_MAX_CHARS": "2400",
                "CONTEXTSTREAM_VSCODE_MCP_MODE": "local"
            }
        },
        "git": {
            "command": "python",
            "args": [
                "-m",
                "mcp_server_git"
            ],
            "type": "stdio"
        },
        "filesystem": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "${workspaceFolder}"
            ],
            "type": "stdio"
        },
        "comfyui-mcp-server": {
            "type": "streamable-http",
            "url": "http://127.0.0.1:9000/mcp"
        },
        "playwright": {
            "type": "stdio",
            "command": "npx",
            "timeout": 30,
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ],
            "disabled": false
        },
        "@21st-dev/magic": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@21st-dev/magic@latest"
            ],
            "env": {
                "API_KEY": "e333eb26f240ec2b8af9df5cd413e441c6ca88775da88f919d2f9776c2b46a04"
            }
        },
        "mobile-mcp": {
            "command": "npx",
            "args": [
                "-y",
                "@mobilenext/mobile-mcp@latest"
            ]
        },
        "github.com/smithery-ai/mcp-obsidian": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "mcp-obsidian",
                "${env:USERPROFILE}\\Programas\\Obsidian"
            ]
        }
    }
}